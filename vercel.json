{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.(css|js|svg|woff2|woff|ttf|png|jpg|jpeg|webp|avif|ico)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=3600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/score-your-content",
      "destination": "/demo",
      "permanent": true
    },
    {
      "source": "/vizit-next-gen-platform",
      "destination": "/platform",
      "permanent": true
    },
    {
      "source": "/vizit-api",
      "destination": "/api",
      "permanent": true
    },
    {
      "source": "/partner-ecosystem",
      "destination": "/partners",
      "permanent": true
    },
    {
      "source": "/customer-support",
      "destination": "/support",
      "permanent": true
    },
    {
      "source": "/case-studies",
      "destination": "/case-study",
      "permanent": true
    },
    {
      "source": "/resources/case-studies",
      "destination": "/case-study",
      "permanent": true
    },
    {
      "source": "/resources/case-studies/:slug",
      "destination": "/case-study/:slug",
      "permanent": true
    },
    {
      "source": "/central-garden-case-study",
      "destination": "/case-study/central-garden",
      "permanent": true
    },
    {
      "source": "/ghirardelli-case-study",
      "destination": "/case-study/ghirardelli",
      "permanent": true
    },
    {
      "source": "/mars-petcare-case-study",
      "destination": "/case-study/mars-petcare",
      "permanent": true
    },
    {
      "source": "/moen-case-study",
      "destination": "/case-study/moen",
      "permanent": true
    },
    {
      "source": "/beauty-case-study",
      "destination": "/case-study/worlds-largest-beauty-company",
      "permanent": true
    },
    {
      "source": "/purina-case-study",
      "destination": "/case-study/purina",
      "permanent": true
    },
    {
      "source": "/blog-article",
      "has": [
        {
          "type": "query",
          "key": "slug"
        }
      ],
      "destination": "/blog/:slug",
      "permanent": true
    },
    {
      "source": "/:path(.+)\\.html",
      "destination": "/:path",
      "permanent": true
    },
    {
      "source": "/js/:path((?!.*\\.js$).*)",
      "destination": "/:path",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/vizit-site.html"
    },
    {
      "source": "/index.html",
      "destination": "/vizit-site.html"
    },
    {
      "source": "/((?!assets/|fonts/).*)",
      "destination": "/vizit-site.html"
    }
  ]
}
